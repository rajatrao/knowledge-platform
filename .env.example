# Local Postgres started by docker-compose.
DATABASE_URL=postgresql+psycopg://kp:kp@localhost:5432/knowledge

# Temporal gRPC. The worker is a separate process from the API.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
ONBOARDING_RUNNER=temporal

# Seeded local users. Usernames are ceo, operations_manager, engineer, marketing.
# Passwords are stored only as bcrypt hashes.
KP_SEED_PASSWORD_CEO=base-ceo-local
KP_SEED_PASSWORD_OPERATIONS_MANAGER=base-ops-local
KP_SEED_PASSWORD_ENGINEER=base-eng-local
KP_SEED_PASSWORD_MARKETING=base-mkt-local

# disk is the default deep-agent filesystem. s3 fails startup if the bucket is missing.
FILESYSTEM=disk
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Knowledge asks execute in a Kubernetes sandbox (namespace sess-{session_id}).
# There is no local subprocess fallback. FILESYSTEM=disk stays the virtual filesystem.
# Leave KUBECONFIG empty to use $HOME/.kube/kind-$KIND_CLUSTER.yaml when that
# file exists. KIND_CLUSTER defaults to knowledge. ./scripts/kind-up.sh writes it.
SANDBOX_RUNTIME_CLASS=gvisor
KUBECONFIG=
KIND_CLUSTER=knowledge

# Intent router. router=llm uses the local Ollama model unless LLM_API_KEY is
# set and the chat settings pick a cloud model. router=jev calls local openJev
# (POST /v1/systemone) and does not need a cloud key. If that URL is unreachable
# the ask fails. Ollama does not need a real key.
# Host uvicorn uses 127.0.0.1. A composed API should use http://ollama:11434/v1
# and http://openjev:8080 (the container listens on 8080; the host port is 8081
# so Temporal UI can keep 8080).
# JEV_MODEL=laya-1.0 matches the CPU image in docker-compose. The NVIDIA image
# razorback16/openjev uses openjev-latest. JEV_API_KEY is optional and is sent
# only when the openJev container sets OPENJEV_API_KEY.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
JEV_API_KEY=
JEV_BASE_URL=http://127.0.0.1:8081
JEV_MODEL=laya-1.0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
TENANT_ID=base
